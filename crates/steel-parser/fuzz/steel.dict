# afl dictionary for the steel reader. Tokens it would otherwise have to
# discover a byte at a time.
open_paren="("
close_paren=")"
open_bracket="["
close_bracket="]"
open_brace="{"
close_brace="}"
vector="#("
bytevector="#u8("
quote="'"
quasiquote="`"
unquote=","
unquote_splicing=",@"
quote_syntax="#'"
quasiquote_syntax="#`"
unquote_syntax="#,"
unquote_splicing_syntax="#,@"
datum_comment="#;"
block_comment_open="#|"
block_comment_close="|#"
line_comment=";"
char="#\\"
char_named="#\\space"
true="#t"
false="#f"
true_long="#true"
string="\""
string_escape="\\n"
pipe_ident="|"
dot="."
ellipsis="..."
define="define"
lambda="lambda"
let="let"
if="if"
begin="begin"
set="set!"
syntax_rules="syntax-rules"
define_syntax="define-syntax"
rational="1/2"
hex="#x1f"
inf="+inf.0"
