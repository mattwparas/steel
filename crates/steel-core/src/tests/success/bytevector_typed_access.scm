;; The typed bytevector accessors, which the jit inlines, against what the
;; primitives give: every element type at its limits, past them, out of
;; bounds, and with the wrong kinds of arguments. Each call runs 300 times so
;; the jit compiles the functions that make it, and the accessors are called
;; outside tail position, where the jit inlines them.
(define (attempt thunk)
  (with-handler (lambda (e) 'error) (thunk)))
(define (repeat n thunk)
  (let loop ([i 0] [last #f]) (if (= i n) last (loop (+ i 1) (thunk)))))
(define (check name expected value)
  (unless (equal? (to-string value) expected)
    (error "typed bytevector access differs:" name expected (to-string value))))
(define (ref-s8 v i) (list (bytevector-s8-ref v i)))
(define (set-s8 v i x) (list (bytevector-s8-set! v i x)))
(define bv-s8 (make-bytes 5 0))
(define raw-s8 (list->bytes (map (lambda (i) (modulo (* i 37) 256)) (range 0 4))))
(define ff-s8 (make-bytes 4 255))
