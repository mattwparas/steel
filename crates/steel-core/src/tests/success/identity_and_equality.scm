;; `eq?` and `eqv?` say that a value is itself, for every kind that has an
;; identity, and `equal?` compares numbers of every kind wherever they are.
(struct point (x y))
(struct counter (n) #:mutable)

;; Run often enough that the compiled comparison is the one checked too.
(define (same? a b) (eq? a b))
(define (same-v? a b) (eqv? a b))
(define (check-identity make)
  (let loop ([n 0])
    (when (< n 300)
      (let ([value (make)]
            [other (make)])
        (assert! (same? value value))
        (assert! (same-v? value value))
        (assert! (not (same? value other)))
        (assert! (not (same-v? value other)))
        (assert! (if (memq value (list 1 other value 2)) #t #f))
        (assert! (not (memq value (list 1 other 2))))
        (assert! (eq? (cdr (assq value (list (cons other 'no) (cons value 'yes)))) 'yes)))
      (loop (+ n 1)))))

(check-identity (lambda () (box 1)))
(check-identity (lambda () (box (list 1 2))))
(check-identity (lambda () (mutable-vector 1 2)))
(check-identity (lambda () (counter 1)))
(check-identity (lambda () (point 1 2)))
(check-identity (lambda () (hash 'a (box 1))))
(check-identity (lambda ()
                  (let ([n (box 0)])
                    (lambda () (unbox n)))))
(check-identity (lambda () (bytes 1 2 3)))

;; A box found through something else is still itself.
(define held (box 'held))
(define holder (mutable-vector held (list held) (point held held)))
(assert! (eq? (vector-ref holder 0) held))
(assert! (eq? (car (vector-ref holder 1)) held))
(assert! (eq? (point-x (vector-ref holder 2)) (point-y (vector-ref holder 2))))
(assert! (eq? (unbox (box held)) held))

;; A box as a key.
(define by-box (hash held 'found))
(assert! (eq? (hash-ref by-box held) 'found))

;; Numbers are the same number wherever they came from.
(define (third) (/ 1 3))
(define (big) (* 4611686018427387904 1000))
(define (big-third) (/ (big) 3))
(assert! (eqv? (third) (third)))
(assert! (eqv? 1/3 (third)))
(assert! (not (eqv? (third) (/ 2 3))))
(assert! (eqv? (big-third) (big-third)))
(assert! (equal? (third) (third)))
(assert! (equal? (list (third)) (list (third))))
(assert! (equal? (list 1 (list (third) "x")) (list 1 (list (third) "x"))))
(assert! (not (equal? (list (third)) (list (/ 2 3)))))
(assert! (equal? (immutable-vector (third)) (immutable-vector (third))))
(assert! (equal? (mutable-vector (third)) (mutable-vector (third))))
(assert! (equal? (hash 'k (third)) (hash 'k (third))))
(assert! (equal? (box (third)) (box (third))))
(assert! (equal? (point (third) 1) (point (third) 1)))
(assert! (equal? (list (big-third)) (list (big-third))))
(assert! (not (equal? (list (big-third)) (list (third)))))
(assert! (equal? (list (big)) (list (big))))
(assert! (equal? (list (make-rectangular 1 2)) (list (make-rectangular 1 2))))
(assert! (not (equal? (list (make-rectangular 1 2)) (list (make-rectangular 1 3)))))
(assert! (equal? (list (make-rectangular (third) 2)) (list (make-rectangular (third) 2))))
(assert! (if (member (third) (list 1 (third) 2)) #t #f))
(assert! (not (member (third) (list 1 2))))

;; Bytevectors and functions, wherever they are.
(assert! (equal? (bytes 1 2 3) (bytes 1 2 3)))
(assert! (equal? (list (bytes 1 2 3)) (list (bytes 1 2 3))))
(assert! (not (equal? (list (bytes 1 2 3)) (list (bytes 1 2 4)))))
(assert! (equal? (cons 1 (bytes 2)) (cons 1 (bytes 2))))
(assert! (equal? (hash 'a (list (bytes 1))) (hash 'a (list (bytes 1)))))
(assert! (equal? (mutable-vector (bytes 1)) (mutable-vector (bytes 1))))
(assert! (equal? (box (bytes)) (box (bytes))))
(assert! (equal? (cons 12345678901234567890 (bytes 1)) (cons 12345678901234567890 (bytes 1))))
(assert! (equal? (list car) (list car)))
(assert! (not (equal? (list car) (list cdr))))
(assert! (equal? (list point-x point?) (list point-x point?)))

