;; One thread registers values with a will executor, one runs the wills and
;; this one collects. A will is handed its value whole.
(struct pair-of (left right) #:mutable)

(define executor (make-will-executor))
(define emptied (box 0))
(define ran (box 0))
(define (will value)
  (set-box! ran (+ 1 (unbox ran)))
  (unless (and (pair-of? value)
               (int? (pair-of-left value))
               (not (void? (pair-of-right value)))
               (int? (unbox (pair-of-right value))))
    (set-box! emptied (+ 1 (unbox emptied)))))

(define (execute)
  (will-execute executor)
  (execute))
(define executing (spawn-native-thread execute))

(define (spin n)
  (when (> n 0)
    (spin (- n 1))))
(define (register i)
  (when (< i 30000)
    (will-register executor (pair-of i (box i)) will)
    (spin 40)
    (register (+ i 1))))
(define registering (spawn-native-thread (lambda () (register 0))))

(define (collect n)
  (when (> n 0)
    (#%gc-collect)
    (collect (- n 1))))
(collect 600)
(thread-join! registering)
(collect 3)
(assert! (> (unbox ran) 0))
(assert! (= (unbox emptied) 0))
