;; arithmetic-shift, the bitwise operations with more than two operands, and + with
;; five to eight operands, which
;; the jit inlines, against Racket's results. Each case runs 300 times so the jit
;; compiles the functions that make it, once with the call outside tail position
;; and once in tail position, before and after the queued compiles finish. The
;; operands come in as arguments, so nothing is folded at compile time.
(define (attempt thunk)
  (with-handler (lambda (e) 'error) (thunk)))
(define (repeat n thunk)
  (let loop ([i 0] [last #f]) (if (= i n) last (loop (+ i 1) (thunk)))))
(define (check name expected value)
  (unless (equal? (to-string value) expected)
    (error "differs from Racket:" name expected (to-string value))))

(define (shift n m) (list (arithmetic-shift n m)))
(define (shift-tail n m) (arithmetic-shift n m))
(define (xor3 a b c) (list (bitwise-xor a b c)))
(define (xor3-tail a b c) (bitwise-xor a b c))
(define (and3 a b c) (list (bitwise-and a b c)))
(define (ior4 a b c d) (list (bitwise-ior a b c d)))
(define (ior4-tail a b c d) (bitwise-ior a b c d))
(define (xor4 a b c d) (list (bitwise-xor a b c d)))
(define (xor5 a b c d e) (list (bitwise-xor a b c d e)))
(define (add5 a b c d e) (list (+ a b c d e)))
(define (add5-tail a b c d e) (+ a b c d e))
(define (add6 a b c d e f) (list (+ a b c d e f)))
(define (add7 a b c d e f g) (list (+ a b c d e f g)))
(define (add8 a b c d e f g h) (list (+ a b c d e f g h)))

