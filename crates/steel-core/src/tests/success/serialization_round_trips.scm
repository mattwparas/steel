;; Every kind of value that can be serialized comes back the same, both as a
;; serialized value and after that has been turned into bytes and back.
(struct point (x y))
(struct shape (name points) #:transparent)
(struct counter (n) #:mutable)
(struct link (next label) #:mutable)
(struct tagged (a b) #:mutable #:transparent)

(define (by-value v) (deserialize-value (serialize-value v)))
(define (by-bytes v) (deserialize-value (bytes->serialized (serialized->bytes (serialize-value v)))))

;; `check` is given a fresh round tripped copy each way.
(define (round-trips make check)
  (assert! (check (by-value (make))))
  (assert! (check (by-bytes (make)))))
(define (same value)
  (round-trips (lambda () value) (lambda (v) (equal? v value))))

;; Plain data.
(same 0)
(same -1)
(same 4611686018427387903)
(same -4611686018427387904)
(same 1.5)
(same -0.25)
(same 1e300)
(same 1/3)
(same -7/2)
(same 12345678901234567890)
(same -98765432109876543210987654321)
(same (/ 12345678901234567890 7))
(same (make-rectangular 1 2))
(same (make-rectangular 1.5 -2.5))
(same #t)
(same #f)
(same #\a)
(same #\λ)
(same #\newline)
(same "")
(same "hello")
(same "λ and \"quotes\" and \n newlines")
(same 'symbol)
(same '|a symbol with spaces|)
(same '())
(same (list 1 2 3))
(same (list 1 "two" 'three 4.5 #\5 (list 6 (list 7))))
(same (cons 1 2))
(same (cons 1 (cons 2 3)))
(same (bytes))
(same (bytes 0 1 2 255))
(same (immutable-vector))
(same (immutable-vector 1 "two" (list 3)))
(same (flat-vector))
(same (flat-vector 1 "two" (list 3) (flat-vector 4)))
(same (hash))
(same (hash 'a 1 'b (list 2) "c" (hash 'd 4)))
(same (hashset))
(same (hashset 1 2 3 "four"))
(same (range 0 500))
(same (map (lambda (n) (list n (number->string n) (* n 1/3))) (range 0 100)))

;; Numbers keep their exactness and their kind.
(round-trips (lambda () 1/3) (lambda (v) (and (exact? v) (= (* 3 v) 1))))
(round-trips (lambda () 2.0) (lambda (v) (and (inexact? v) (= v 2))))
(round-trips (lambda () 12345678901234567890) (lambda (v) (= (+ v 1) 12345678901234567891)))
(round-trips (lambda () (list 1/3 2/3)) (lambda (v) (= (apply + v) 1)))

;; A symbol comes back as the same symbol, wherever it was.
(round-trips (lambda () 'again) (lambda (v) (eq? v 'again)))
(round-trips (lambda () (list 'a (list 'b) (hash 'k 'c)))
             (lambda (v) (and (eq? (car v) 'a) (eq? (car (cadr v)) 'b) (eq? (hash-ref (caddr v) 'k) 'c))))

;; Mutable vectors and boxes come back as ones that can be changed.
(round-trips (lambda () (mutable-vector 1 2 3))
             (lambda (v)
               (vector-set! v 0 'changed)
               (vector-push! v 4)
               (and (eq? (vector-ref v 0) 'changed) (= (vector-length v) 4))))
(round-trips (lambda () (mutable-vector)) (lambda (v) (= (vector-length v) 0)))
(round-trips (lambda () (box (list 1 2)))
             (lambda (v)
               (and (equal? (unbox v) (list 1 2))
                    (begin
                      (set-box! v 'changed)
                      (eq? (unbox v) 'changed)))))
(round-trips (lambda () (box (box (box 7)))) (lambda (v) (= (unbox (unbox (unbox v))) 7)))
(round-trips (lambda () (mutable-vector (mutable-vector 1) (box 2)))
             (lambda (v) (and (= (vector-ref (vector-ref v 0) 0) 1) (= (unbox (vector-ref v 1)) 2))))

;; Structs of each kind.
(round-trips (lambda () (point 1 2)) (lambda (v) (and (point? v) (= (point-x v) 1) (= (point-y v) 2))))
(round-trips (lambda () (shape "square" (list (point 0 0) (point 1 1))))
             (lambda (v)
               (and (shape? v) (equal? (shape-name v) "square") (= (point-y (cadr (shape-points v))) 1))))
(same (shape "line" (list 1 2)))
(round-trips (lambda () (counter 5))
             (lambda (v)
               (and (counter? v)
                    (= (counter-n v) 5)
                    (begin
                      (set-counter-n! v 6)
                      (= (counter-n v) 6)))))
(round-trips (lambda () (tagged 1 (list 2)))
             (lambda (v)
               (and (tagged? v)
                    (equal? (tagged-b v) (list 2))
                    (begin
                      (set-tagged-a! v 'changed)
                      (eq? (tagged-a v) 'changed)))))
(same (tagged 1 2))
(round-trips (lambda () (list (point 1 2) (counter 3) (tagged 4 5)))
             (lambda (v) (and (point? (car v)) (counter? (cadr v)) (tagged? (caddr v)))))
(round-trips (lambda () (counter (point (counter 1) 2)))
             (lambda (v) (= (counter-n (point-x (counter-n v))) 1)))
;; A value of one struct type is not taken for another.
(round-trips (lambda () (point 1 2)) (lambda (v) (and (not (counter? v)) (not (shape? v)))))

;; One thing referred to twice comes back as one thing.
(round-trips (lambda ()
               (let ([shared (box 1)])
                 (list shared shared)))
             (lambda (v)
               (set-box! (car v) 'changed)
               (and (eq? (unbox (cadr v)) 'changed) (eq? (car v) (cadr v)))))
(round-trips (lambda ()
               (let ([shared (mutable-vector 1)])
                 (hash 'a shared 'b shared)))
             (lambda (v)
               (vector-set! (hash-ref v 'a) 0 'changed)
               (eq? (vector-ref (hash-ref v 'b) 0) 'changed)))
(round-trips (lambda ()
               (let ([shared (counter 1)])
                 (mutable-vector shared (box shared) (list shared))))
             (lambda (v)
               (set-counter-n! (vector-ref v 0) 'changed)
               (and (eq? (counter-n (unbox (vector-ref v 1))) 'changed)
                    (eq? (counter-n (car (vector-ref v 2))) 'changed)
                    (eq? (vector-ref v 0) (unbox (vector-ref v 1))))))
;; That goes for values that can't be changed as well.
(round-trips (lambda ()
               (let ([shared (immutable-vector 1 2 3)])
                 (list shared shared (box shared))))
             (lambda (v) (and (eq? (car v) (cadr v)) (eq? (car v) (unbox (caddr v))))))
(round-trips (lambda ()
               (let ([shared (point 1 2)])
                 (hash 'a shared 'b shared)))
             (lambda (v) (eq? (hash-ref v 'a) (hash-ref v 'b))))
(round-trips (lambda ()
               (let ([shared (lambda (m) (+ 1 m))])
                 (list shared shared)))
             (lambda (v) (and (eq? (car v) (cadr v)) (= ((car v) 1) 2))))
(round-trips (lambda () (list (immutable-vector 1 2) (immutable-vector 1 2)))
             (lambda (v) (and (equal? (car v) (cadr v)) (not (eq? (car v) (cadr v))))))
;; And two that only look alike stay two.
(round-trips (lambda () (list (box 1) (box 1)))
             (lambda (v)
               (set-box! (car v) 'changed)
               (and (= (unbox (cadr v)) 1) (not (eq? (car v) (cadr v))))))

;; Cycles, through every kind of cell.
(round-trips (lambda ()
               (let ([b (box #f)])
                 (set-box! b (list b 1))
                 b))
             (lambda (v) (and (eq? (car (unbox v)) v) (= (cadr (unbox v)) 1))))
(round-trips (lambda ()
               (let ([v (mutable-vector #f 1)])
                 (vector-set! v 0 v)
                 v))
             (lambda (v) (and (eq? (vector-ref v 0) v) (= (vector-ref v 1) 1) (= (vector-length v) 2))))
(round-trips (lambda ()
               (let* ([a (link #f 'a)]
                      [b (link a 'b)]
                      [c (link b 'c)])
                 (set-link-next! a c)
                 a))
             (lambda (v)
               (and (eq? (link-label v) 'a)
                    (eq? (link-label (link-next v)) 'c)
                    (eq? (link-label (link-next (link-next v))) 'b)
                    (eq? (link-next (link-next (link-next v))) v))))
(round-trips (lambda ()
               (let ([a (link #f 'self)])
                 (set-link-next! a a)
                 a))
             (lambda (v) (eq? (link-next v) v)))
(round-trips (lambda ()
               (let* ([cell (box #f)]
                      [p (point cell 'in-a-cycle)])
                 (set-box! cell p)
                 p))
             (lambda (v) (and (point? (unbox (point-x v))) (eq? (point-y (unbox (point-x v))) 'in-a-cycle))))
(round-trips (lambda ()
               (let* ([b (box #f)]
                      [v (mutable-vector b)]
                      [s (link v 'mixed)])
                 (set-box! b s)
                 s))
             (lambda (v) (eq? (unbox (vector-ref (link-next v) 0)) v)))
(round-trips (lambda ()
               (let* ([a (box #f)]
                      [b (box a)])
                 (set-box! a b)
                 (list a b)))
             (lambda (v) (and (eq? (unbox (car v)) (cadr v)) (eq? (unbox (cadr v)) (car v)))))

;; Functions.
(define offset 100)
(define (add-offset n) (+ n offset))
(define (fact n)
  (if (= n 0) 1 (* n (fact (- n 1)))))
(define (even-n? n)
  (if (= n 0) #t (odd-n? (- n 1))))
(define (odd-n? n)
  (if (= n 0) #f (even-n? (- n 1))))
(define (make-adder n) (lambda (m) (+ n m)))
(define (make-counter)
  (let ([count (box 0)])
    (lambda ()
      (set-box! count (+ (unbox count) 1))
      (unbox count))))

(round-trips (lambda () car) (lambda (f) (= (f (list 1 2)) 1)))
(round-trips (lambda () +) (lambda (f) (= (f 1 2 3) 6)))
(round-trips (lambda () (lambda (x) (* x 2))) (lambda (f) (= (f 21) 42)))
(round-trips (lambda () (lambda args (length args))) (lambda (f) (= (f 1 2 3) 3)))
(round-trips (lambda () (lambda (a . rest) (cons a rest))) (lambda (f) (equal? (f 1 2 3) (list 1 2 3))))
(round-trips (lambda () (lambda () "a constant")) (lambda (f) (equal? (f) "a constant")))
(round-trips (lambda () (lambda () '(a quoted (list) 1 2.5 "s"))) (lambda (f) (equal? (f) '(a quoted (list) 1 2.5 "s"))))
(round-trips (lambda () (lambda () (list 1/3 12345678901234567890 'sym))) (lambda (f) (equal? (f) (list 1/3 12345678901234567890 'sym))))
(round-trips (lambda () add-offset) (lambda (f) (= (f 1) 101)))
(round-trips (lambda () fact) (lambda (f) (= (f 10) 3628800)))
(round-trips (lambda () even-n?) (lambda (f) (and (f 10) (not (f 7)))))
(round-trips (lambda () (make-adder 5)) (lambda (f) (= (f 6) 11)))
(round-trips (lambda () (make-adder 1/2)) (lambda (f) (= (f 1/2) 1)))
(round-trips (lambda () (make-counter)) (lambda (f) (and (= (f) 1) (= (f) 2) (= (f) 3))))
(round-trips (lambda ()
               (let ([state (counter 10)])
                 (lambda ()
                   (set-counter-n! state (+ 1 (counter-n state)))
                   (counter-n state))))
             (lambda (f) (and (= (f) 11) (= (f) 12))))
(round-trips (lambda ()
               (let ([items (mutable-vector)])
                 (lambda (x)
                   (vector-push! items x)
                   (vector-length items))))
             (lambda (f) (and (= (f 'a) 1) (= (f 'b) 2))))
(round-trips (lambda () (list (make-adder 1) (make-adder 2) (make-adder 3)))
             (lambda (fs) (equal? (map (lambda (f) (f 10)) fs) (list 11 12 13))))
(round-trips (lambda () (hash 'double (lambda (x) (* 2 x)) 'data (list 1 2)))
             (lambda (h) (= ((hash-ref h 'double) (car (hash-ref h 'data))) 2)))
(round-trips (lambda () (lambda (xs) (map (lambda (x) (+ x 1)) xs)))
             (lambda (f) (equal? (f (list 1 2 3)) (list 2 3 4))))
(round-trips (lambda () (lambda (n) (make-adder n))) (lambda (f) (= ((f 1) 2) 3)))
(round-trips (lambda () (lambda (x) (point x x))) (lambda (f) (= (point-y (f 3)) 3)))
(round-trips (lambda () point-x) (lambda (f) (= (f (point 8 9)) 8)))
(round-trips (lambda () point) (lambda (f) (= (point-y (f 8 9)) 9)))
(round-trips (lambda () counter?) (lambda (f) (and (f (counter 1)) (not (f 1)))))
;; Two functions that share a cell still share it.
(round-trips (lambda ()
               (let ([cell (box 0)])
                 (list (lambda () (set-box! cell (+ 1 (unbox cell)))) (lambda () (unbox cell)))))
             (lambda (fs)
               ((car fs))
               ((car fs))
               (= ((cadr fs)) 2)))

;; A function read back where it was written uses the globals that are there,
;; and reading it leaves them as they were.
(define shared-cell (box 0))
(define (read-shared) (unbox shared-cell))
(define (bump-shared!) (set-box! shared-cell (+ 1 (unbox shared-cell))))
(define cell-before shared-cell)
(define read-again (by-value read-shared))
(define bump-again (by-bytes bump-shared!))
(assert! (eq? shared-cell cell-before))
(set-box! shared-cell 5)
(assert! (= (read-again) 5))
(bump-again)
(assert! (= (unbox shared-cell) 6))
(assert! (= (read-shared) 6))
(define add-offset-again (by-value add-offset))
(set! offset 1000)
(assert! (= (add-offset-again 1) 1001))
(set! offset 100)

;; The copy is a copy.
(define original (mutable-vector 1 2 3))
(define copy (by-value original))
(vector-set! copy 0 'changed)
(assert! (= (vector-ref original 0) 1))
(define original-box (box (list 1)))
(set-box! (by-bytes original-box) 'changed)
(assert! (equal? (unbox original-box) (list 1)))
(define original-counter (counter 1))
(set-counter-n! (by-value original-counter) 2)
(assert! (= (counter-n original-counter) 1))

;; One serialized value can be read more than once, and each reading is new.
(define serialized (serialize-value (list (box 1) (make-adder 2) (counter 3) 'sym)))
(define first-reading (deserialize-value serialized))
(define second-reading (deserialize-value serialized))
(set-box! (car first-reading) 'changed)
(assert! (= (unbox (car second-reading)) 1))
(assert! (= ((cadr second-reading) 1) 3))
(assert! (= (counter-n (caddr second-reading)) 3))
(define as-bytes (serialized->bytes serialized))
(assert! (equal? (unbox (car (deserialize-value (bytes->serialized as-bytes)))) 1))
(assert! (equal? as-bytes (serialized->bytes serialized)))

;; The same value can be serialized again and again.
(define adder (make-adder 7))
(assert! (= ((by-value adder) 1) 8))
(assert! (= ((by-value adder) 2) 9))
(assert! (= ((by-bytes adder) 3) 10))
(assert! (= ((by-bytes (by-value (by-bytes adder))) 4) 11))
(define shape-value (shape "again" (list (tagged 1 2))))
(assert! (equal? (by-bytes (by-value shape-value)) shape-value))
(assert! (equal? (by-value (by-bytes shape-value)) shape-value))

;; Something big.
(define (tree depth)
  (if (= depth 0)
      (box (list depth "leaf" 'leaf))
      (mutable-vector (tree (- depth 1)) (point depth (tree (- depth 1))) (hash 'depth depth))))
(round-trips (lambda () (tree 8))
             (lambda (v) (and (= (hash-ref (vector-ref v 2) 'depth) 8) (= (point-x (vector-ref v 1)) 8))))
(define long-list (range 0 20000))
(assert! (equal? (by-bytes long-list) long-list))
(define (chain n previous)
  (if (= n 0) previous (chain (- n 1) (link previous n))))
(define (chain-length l n)
  (if (link? l) (chain-length (link-next l) (+ n 1)) n))
(round-trips (lambda () (chain 2000 #f))
             (lambda (v) (and (= (link-label v) 1) (= (chain-length v 0) 2000))))
