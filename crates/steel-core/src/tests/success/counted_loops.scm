;; Loops that count a fixnum up or down to a bound. Compiled code runs these a
;; stretch of trips at a time and only looks for other threads between
;; stretches, so the answers are checked for counts on both sides of a
;; stretch's end, and threads in such loops still have to stop when asked.
(require-builtin steel/time)

;; Named lets, since a function that calls itself directly has one trip
;; unrolled into it and is then not a loop of this shape.
(define (up-below from n start)
  (let counted-up-below ([i from] [acc start])
    (if (< i n) (counted-up-below (+ i 1) (+ acc i)) acc)))
(define (up-through from n start)
  (let counted-up-through ([i from] [acc start])
    (if (<= i n) (counted-up-through (+ i 1) (+ acc i)) acc)))
(define (up-until-equal from n start)
  (let counted-up-until-equal ([i from] [acc start])
    (if (= i n) acc (counted-up-until-equal (+ i 1) (+ acc i)))))
(define (up-by-three from n start)
  (let counted-up-by-three ([i from] [acc start])
    (if (>= i n) acc (counted-up-by-three (+ i 3) (+ acc 1)))))
(define (down-to-zero from start)
  (let counted-down-to-zero ([i from] [acc start])
    (if (< i 0) acc (counted-down-to-zero (- i 1) (+ acc i)))))
(define (down-above from n start)
  (let counted-down-above ([i from] [acc start])
    (if (> i n) (counted-down-above (- i 1) (+ acc i)) acc)))
(define (down-until-equal from start)
  (let counted-down-until-equal ([i from] [acc start])
    (if (= i 0) acc (counted-down-until-equal (- i 1) (+ acc i)))))
(define (down-by-seven from n start)
  (let counted-down-by-seven ([i from] [acc start])
    (if (<= i n) acc (counted-down-by-seven (- i 7) (+ acc 1)))))
(define (below-a-constant from start)
  (let counted-below-a-constant ([i from] [acc start])
    (if (< i 5000) (counted-below-a-constant (+ i 1) (+ acc i)) acc)))
;; Up to the length of a vector, which is read once a stretch while no
;; other thread could be shortening it.
(define (through-a-vector v from start)
  (let counted-through-a-vector ([i from] [acc start])
    (if (>= i (vector-length v))
        acc
        (counted-through-a-vector (+ i 1) (+ acc (vector-ref v i))))))
(define (fill-a-vector v)
  (let counted-fill-a-vector ([i 0])
    (when (< i (vector-length v))
      (vector-set! v i (* 2 i))
      (counted-fill-a-vector (+ i 1)))))
(define (fill-until-the-length v)
  (do ((i 0 (+ i 1))) ((= i (vector-length v))) (vector-set! v i (* 3 i))))
;; The length changes under this one, so it is not read once a stretch.
(define (grow-a-vector v)
  (let grow ([i 0])
    (when (< i (vector-length v))
      (when (< (vector-length v) 3000)
        (vector-push! v i))
      (grow (+ i 1)))))
;; Functions that call themselves, which have a trip unrolled into them. The
;; counter then moves two steps a time around, with a test in between.
(define (counted-unrolled-up-below i n acc)
  (if (< i n) (counted-unrolled-up-below (+ i 1) n (+ acc i)) acc))
(define (counted-unrolled-up-through i n acc)
  (if (<= i n) (counted-unrolled-up-through (+ i 1) n (+ acc i)) acc))
(define (counted-unrolled-until-equal i n acc)
  (if (= i n) acc (counted-unrolled-until-equal (+ i 1) n (+ acc i))))
(define (counted-unrolled-by-three i n acc)
  (if (>= i n) acc (counted-unrolled-by-three (+ i 3) n (+ acc 1))))
(define (counted-unrolled-down i acc)
  (if (< i 0) acc (counted-unrolled-down (- i 1) (+ acc i))))
(define (counted-unrolled-down-until-equal i acc)
  (if (= i 0) acc (counted-unrolled-down-until-equal (- i 1) (+ acc i))))
(define (counted-unrolled-through-a-vector v i acc)
  (if (>= i (vector-length v))
      acc
      (counted-unrolled-through-a-vector v (+ i 1) (+ acc (vector-ref v i)))))

;; 0 + 1 + ... + (n - 1)
(define (triangle n) (quotient (* n (- n 1)) 2))
(define (trips from to step) (if (>= from to) 0 (quotient (+ (- to from) (- step 1)) step)))

(define (check n)
  (assert! (= (up-below 0 n 0) (triangle n)))
  (assert! (= (up-through 0 n 0) (triangle (+ n 1))))
  (assert! (= (up-until-equal 0 n 0) (triangle n)))
  (assert! (= (up-by-three 0 n 0) (trips 0 n 3)))
  (assert! (= (down-to-zero n 0) (triangle (+ n 1))))
  (assert! (= (down-above n 0 0) (triangle (+ n 1))))
  (assert! (= (down-until-equal n 0) (triangle (+ n 1))))
  (assert! (= (down-by-seven n 0 0) (trips 0 n 7)))
  (assert! (= (counted-unrolled-up-below 0 n 0) (triangle n)))
  (assert! (= (counted-unrolled-up-below 1 n 0) (triangle (max n 1))))
  (assert! (= (counted-unrolled-up-through 0 n 0) (triangle (+ n 1))))
  (assert! (= (counted-unrolled-up-through 1 n 0) (triangle (+ n 1))))
  (assert! (= (counted-unrolled-until-equal 0 n 0) (triangle n)))
  (assert! (= (counted-unrolled-until-equal -1 n 0) (- (triangle n) 1)))
  (assert! (= (counted-unrolled-by-three 0 n 0) (trips 0 n 3)))
  (assert! (= (counted-unrolled-by-three 1 n 0) (trips 1 n 3)))
  (assert! (= (counted-unrolled-down n 0) (triangle (+ n 1))))
  (assert! (= (counted-unrolled-down (+ n 1) 0) (triangle (+ n 2))))
  (assert! (= (counted-unrolled-down-until-equal n 0) (triangle (+ n 1))))
  (assert! (= (counted-unrolled-down-until-equal (+ n 1) 0) (triangle (+ n 2))))
  (assert! (= (counted-unrolled-up-below (+ n 1) n 7) 7))
  (assert! (= (counted-unrolled-down -1 7) 7))
  (let ([v (make-vector n 1)])
    (assert! (= (through-a-vector v 0 0) n))
    (fill-a-vector v)
    (assert! (= (through-a-vector v 0 0) (* 2 (triangle n))))
    (fill-until-the-length v)
    (assert! (= (through-a-vector v 0 0) (* 3 (triangle n))))
    (assert! (= (through-a-vector v (+ n 1) 7) 7))
    (assert! (= (counted-unrolled-through-a-vector v 0 0) (* 3 (triangle n))))
    (assert! (= (counted-unrolled-through-a-vector v 1 0) (* 3 (triangle n)))))
  ;; Starting part way, and from the far side of zero.
  (assert! (= (up-below 5 n 0) (- (triangle (max n 5)) (triangle 5))))
  (assert! (= (up-below -10 n 0) (- (triangle n) 55)))
  ;; Already past the bound, so no trips at all.
  (assert! (= (up-below (+ n 1) n 7) 7))
  (assert! (= (down-above -1 0 7) 7))
  (assert! (= (down-to-zero -1 7) 7)))

;; Enough of each to be compiled, then the counts around the end of a
;; stretch, and of several.
(define (warm n)
  (when (> n 0)
    (check 300)
    (warm (- n 1))))
(warm 200)
(for-each check (list 0 1 2 1022 1023 1024 1025 1026 2047 2048 2049 3071 3072 3073 10000 65537))

(define growing (mutable-vector 1))
(define (grow-again n)
  (when (> n 0)
    (grow-a-vector growing)
    (grow-again (- n 1))))
(grow-again 200)
(assert! (= (vector-length growing) 3000))

;; A list where the vector goes is still an error.
(assert! (eq? 'raised (with-handler (lambda (e) 'raised) (through-a-vector (list 1 2 3) 0 0))))
(assert! (= (through-a-vector (vector 1 2 3) 0 0) 6))

(define numbers (mutable-vector))
(define (fill n)
  (when (> n 0)
    (vector-push! numbers n)
    (fill (- n 1))))
(fill 5000)
(define (again n)
  (when (> n 0)
    (assert! (= (through-a-vector numbers 0 0) (triangle 5001)))
    (assert! (= (below-a-constant 0 0) (triangle 5000)))
    (again (- n 1))))
(again 200)

;; A vector that another thread shortens and lengthens while this one is
;; part way along it. Each trip has to see the length as it is then.
(define shifting (mutable-vector))
(define (refill n)
  (when (> n 0)
    (vector-push! shifting 1)
    (refill (- n 1))))
(refill 4000)
(define settled (box #f))
(define (reshape n)
  (unless (unbox settled)
    (if (and (odd? n) (> (vector-length shifting) 0))
        (mutable-vector-pop! shifting)
        (vector-push! shifting 1))
    (reshape (+ n 1))))
(define shifting-it (spawn-native-thread (lambda () (reshape 0))))
;; Reading past the end raises, which an element taken away between the
;; test and the read can still cause. So can only happen at the very end.
(define (walk n)
  (when (> n 0)
    (let ([sum (with-handler (lambda (e) 'raced) (through-a-vector shifting 0 0))])
      (assert! (or (eq? sum 'raced) (and (>= sum 0) (<= sum 5000000)))))
    (walk (- n 1))))
(walk 300)
(set-box! settled #t)
(thread-join! shifting-it)

;; A count that runs into the end of the fixnums carries on past it.
(define near-the-end 4611686018427387000)
(assert! (= (up-by-three near-the-end (+ near-the-end 30000) 0) 10000))

;; A count that starts beside the last fixnum, toward a bound it never meets,
;; steps past it like any other. The second exit is what ends these.
(define (rising-until-equal from n)
  (let lp ([i from] [k 0])
    (if (= i n)
        (list 'met i k)
        (if (< k 5)
            (lp (+ i 1) (+ k 1))
            (list 'gave-up i k)))))
(define (falling-until-equal from n)
  (let lp ([i from] [k 0])
    (if (= i n)
        (list 'met i k)
        (if (< k 5)
            (lp (- i 1) (+ k 1))
            (list 'gave-up i k)))))
(define (rising-by-two-until-equal from n)
  (let lp ([i from] [k 0])
    (if (= i n)
        (list 'met i k)
        (if (< k 6)
            (lp (+ i 2) (+ k 1))
            (list 'gave-up i k)))))
(define (falling-by-two-until-equal from n)
  (let lp ([i from] [k 0])
    (if (= i n)
        (list 'met i k)
        (if (< k 6)
            (lp (- i 2) (+ k 1))
            (list 'gave-up i k)))))
(define (compile-those count)
  (when (> count 0)
    (rising-until-equal 0 40)
    (falling-until-equal 40 0)
    (rising-by-two-until-equal 0 40)
    (falling-by-two-until-equal 40 0)
    (compile-those (- count 1))))
(compile-those 300)

(define last-fixnum 9223372036854775807)
(define first-fixnum -9223372036854775808)
(assert! (equal? (rising-until-equal (- last-fixnum 2) 0) (list 'gave-up (+ last-fixnum 3) 5)))
(assert! (equal? (falling-until-equal (+ first-fixnum 2) 0) (list 'gave-up (- first-fixnum 3) 5)))
(assert! (equal? (rising-by-two-until-equal (- last-fixnum 4) 0) (list 'gave-up (+ last-fixnum 8) 6)))
(assert! (equal? (falling-by-two-until-equal (+ first-fixnum 4) 0)
                 (list 'gave-up (- first-fixnum 8) 6)))
(assert! (equal? (rising-until-equal last-fixnum 0) (list 'gave-up (+ last-fixnum 5) 5)))
(assert! (equal? (rising-until-equal (- last-fixnum 3) last-fixnum) (list 'met last-fixnum 3)))

;; Threads counting toward bounds they will not reach while the test runs.
;; A collection stops each of them, and so does an interrupt.
(define far 1000000000000000)
(define (raised? thread)
  (eq? 'raised (with-handler (lambda (e) 'raised) (thread-join! thread))))
(define counting
  (list (spawn-native-thread (lambda () (up-below 0 far 0)))
        (spawn-native-thread (lambda () (up-until-equal 0 far 0)))
        (spawn-native-thread (lambda () (down-above 0 (- far) 0)))
        (spawn-native-thread (lambda () (up-by-three 0 far 0)))
        (spawn-native-thread (lambda () (down-until-equal -1 0)))
        (spawn-native-thread (lambda () (counted-unrolled-up-below 0 far 0)))
        (spawn-native-thread (lambda () (counted-unrolled-until-equal 0 far 0)))
        (spawn-native-thread (lambda () (counted-unrolled-until-equal 1 far 0)))
        (spawn-native-thread (lambda () (counted-unrolled-down-until-equal -1 0)))
        (spawn-native-thread (lambda () (counted-unrolled-down-until-equal -2 0)))))
(time/sleep-ms 20)
(#%gc-collect)
(#%gc-collect)
(for-each thread-interrupt counting)
(#%gc-collect)
(for-each (lambda (thread) (assert! (raised? thread))) counting)
