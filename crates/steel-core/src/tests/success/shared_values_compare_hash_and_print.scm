(struct s (x) #:transparent)

;; The same value twice on each side
(define (same-twice? a b)
  (and (equal? (list a a) (list b b)) (equal? (vector a a) (vector b b))))
(assert! (same-twice? (immutable-vector 5) (immutable-vector 5)))
(assert! (same-twice? (mutable-vector 5) (mutable-vector 5)))
(assert! (same-twice? (s 1) (s 1)))
(assert! (same-twice? (cons 1 2) (cons 1 2)))
(assert! (same-twice? (hash 'a 1) (hash 'a 1)))
(assert! (same-twice? (box 1) (box 1)))

;; A value compared once is still compared against a different one
(define (differs-once? a b c)
  (not (or (equal? (list a a) (list b c))
           (equal? (list a a) (list c b))
           (equal? (list a c) (list b b))
           (equal? (list c a) (list b b)))))
(assert! (differs-once? (immutable-vector 1) (immutable-vector 1) (immutable-vector 2)))
(assert! (differs-once? (mutable-vector 1) (mutable-vector 1) (mutable-vector 2)))
(assert! (differs-once? (s 1) (s 1) (s 2)))
(assert! (differs-once? (cons 1 2) (cons 1 2) (cons 1 3)))
(assert! (differs-once? (hash 'a 1) (hash 'a 1) (hash 'a 2)))
(assert! (differs-once? (hashset 1) (hashset 1) (hashset 2)))

(define (cyclic last)
  (let ([v (mutable-vector 1 last)])
    (vector-set! v 0 v)
    v))
(assert! (equal? (cyclic 2) (cyclic 2)))
(assert! (not (equal? (cyclic 2) (cyclic 3))))

;; Hash sets and hash maps are equal and hash alike in any order
(assert! (not (equal? (hashset 1 2) (hashset 1 3))))
(assert! (equal? (hashset 1 2 3) (hashset 3 2 1)))
(assert! (eq? 'found (hash-try-get (hash (hashset 1 2 3) 'found) (hashset 3 2 1))))
(assert! (eq? 'found (hash-try-get (hash (hash 'a 1 'b 2 'c 3 'd 4) 'found) (hash 'd 4 'c 3 'b 2 'a 1))))
(assert! (hashset-contains? (hashset (hashset 1 2 3 4 5 6 7 8 9)) (hashset 9 8 7 6 5 4 3 2 1)))
(assert! (eq? 'found
              (hash-try-get (hash (apply hashset (range 0 500)) 'found)
                            (apply hashset (reverse (range 0 500))))))
(define (round-trip v) (deserialize-value (serialize-value v)))
(assert! (eq? 'found (hash-try-get (round-trip (hash (hashset 1 2 3) 'found)) (hashset 1 2 3))))

;; A rational whose numerator is the least i32
(define least (/ -2147483648 3))
(assert! (equal? (abs least) (/ 2147483648 3)))
(assert! (equal? (magnitude least) (/ 2147483648 3)))
(assert! (= (floor least) -715827883))
(assert! (= (ceiling least) -715827882))
(assert! (= (round least) -715827883))
(assert! (= (truncate least) -715827882))
(assert! (equal? (/ 1 least) (/ -3 2147483648)))
(assert! (= (floor (/ -7 2)) -4))
(assert! (= (ceiling (/ -7 2)) -3))
(assert! (= (round (/ 7 2)) 4))
(assert! (= (round (/ -5 2)) -2))
(assert! (= (abs -9223372036854775808) 9223372036854775808))

;; Boxes that are shared or hold themselves print
(define shared (list (box 1.5)))
(assert! (string? (to-string (list shared shared))))
(define self (box 1))
(set-box! self self)
(assert! (string? (to-string self)))
(assert! (string? (to-string (list self (box self)))))
(define first (box 1))
(define second (box first))
(set-box! first second)
(assert! (string? (to-string first)))

(define (shown v)
  (let ([port (open-output-string)])
    (display v port)
    (get-output-string port)))
(assert! (box? (box 1)))
(assert! (not (box? 1)))
(assert! (equal? (shown (list (box 1) (box "a"))) "('#&1 '#&a)"))
(assert! (equal? (shown self) "#0='#&#0#\n'#&#0#"))
(assert! (equal? (shown (list shared shared)) "#0='#&1.5\n((#0#) (#0#))"))
